# Perfil ativo (local | aws)
SPRING_PROFILES_ACTIVE=local

# Servidor HTTP
SERVER_PORT=8080

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Parametros de inferencia do modelo
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=600
AI_MAX_TOOL_CALLS=2
AI_TOOL_TIMEOUT_MS=3000

# OpenSearch local (Docker)
OPENSEARCH_URIS=http://localhost:9200
OPENSEARCH_INDEX_NAME=communication-knowledge-base
OPENSEARCH_EMBEDDING_DIMENSIONS=768

# Parametros RAG
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.35

# Futuro profile AWS (nao utilizado no MVP local; usar IAM Role / AWS SSO, nunca chaves hardcoded)
# AWS_REGION=us-east-1
